#!/usr/bin/env python3
"""D12k2: Variance-hardened rerun of D12k (entangled vs classical-matched channel).

Purpose: certify (or overturn) D12k's KILL verdict, which was based on 8 pairs
x 5 draws and a single noisy +0.10 spike at T=25. This run: N=64 cells (32
pairs), 20 pairing draws per T, and a per-draw paired diff with a mean/CI read
instead of a single-point gate.

Gate (pre-registered): entanglement matters iff mean diff (ent - cls) has a
95% bootstrap CI excluding 0 with positive sign at ANY of T in {10,25,50,100}.

CPU-only, seconds. Guard untouched. Seed 2718.
"""
import json, math, os, random
import numpy as np

SEED = 2718
N_CELLS = 64          # 32 pairs
N_DRAWS = 20
T_LIST = [5, 10, 25, 50, 100, 200]
OUT = os.path.join(os.path.dirname(__file__), "..", "results", "d12k2_entangled_certified.json")


def su2_random(rng):
    a, b, c, d = (rng.gauss(0, 1) for _ in range(4))
    M = np.array([[a + 1j * b, c + 1j * d], [-c + 1j * d, a - 1j * b]], dtype=complex)
    M /= math.sqrt(np.trace(M @ M.conj().T).real)
    return M


def bell_sample(U_A, U_B, T, rng):
    Phi = np.array([1 / math.sqrt(2), 0, 0, 1 / math.sqrt(2)], dtype=complex)
    psi = np.kron(U_A, U_B) @ Phi
    rho = np.outer(psi, psi.conj())
    probs = np.abs(np.diag(rho)).real
    probs /= probs.sum()
    idx = np.array(rng.choices(range(4), weights=probs.tolist(), k=T))
    a = (idx % 2) * 2 - 1
    b = (idx // 2) * 2 - 1
    return a.astype(float), b.astype(float)


def classical_match(a, b, T, rng):
    r = np.corrcoef(a, b)[0, 1]
    q = (1 + r) / 2
    flip = np.array([rng.random() for _ in range(T)]) > q
    return a.copy(), np.where(flip, -a, a).astype(float)


def fair_bits(T, rng):
    return np.array([1.0 if rng.random() < 0.5 else -1.0 for _ in range(T)])


def partner_id_acc(streams, pairs):
    S = np.array(streams)
    S = S - S.mean(axis=1, keepdims=True)
    sd = S.std(axis=1)
    sd[sd == 0] = 1e-12
    C = (S @ S.T) / (S.shape[1] * np.outer(sd, sd))
    np.fill_diagonal(C, 0)
    correct = sum(1 for i, j in pairs if abs(C[i, j]) >= np.abs(C[i]).max() - 1e-12)
    return correct / len(pairs)


rng = random.Random(SEED)
results = {"acc_ent": {}, "acc_cls": {}, "mean_corr_e": [], "mean_corr_c": []}
paired_diffs = {}
for T in T_LIST:
    de, dc = [], []
    for _ in range(N_DRAWS):
        cells = rng.sample(range(N_CELLS), N_CELLS)
        pairs = [(cells[2 * k], cells[2 * k + 1]) for k in range(N_CELLS // 2)]
        # build one draw: entangled and classical streams from the SAME su2 draws,
        # two independent pairing topologies (as D12k) but per-draw paired diff
        se, sc = [None] * N_CELLS, [None] * N_CELLS
        ce, cc = [None] * N_CELLS, [None] * N_CELLS
        for i, j in pairs:
            UA, UB = su2_random(rng), su2_random(rng)
            a, b = bell_sample(UA, UB, T, rng)
            ac, bc = classical_match(a, b, T, rng)
            se[i], se[j] = a, b
            sc[i], sc[j] = ac, bc
            ce[i], cc[j] = None, None  # unused; keep index symmetrical
            results["mean_corr_e"].append(float(np.corrcoef(a, b)[0, 1]))
            results["mean_corr_c"].append(float(np.corrcoef(ac, bc)[0, 1]))
        for k in range(N_CELLS):
            if se[k] is None:
                se[k] = fair_bits(T, rng)
            if sc[k] is None:
                sc[k] = fair_bits(T, rng)
        ae = partner_id_acc(se, pairs)
        ac_ = partner_id_acc(sc, pairs)
        de.append(ae)
        dc.append(ac_)
    results["acc_ent"][T] = float(np.mean(de))
    results["acc_cls"][T] = float(np.mean(dc))
    paired_diffs[T] = [e - c for e, c in zip(de, dc)]

# bootstrap CI on mean paired diff per T
rng_b = np.random.default_rng(SEED)
ci = {}
for T in T_LIST:
    d = np.array(paired_diffs[T])
    boots = [float(np.mean(rng_b.choice(d, size=len(d), replace=True))) for _ in range(2000)]
    lo, hi = float(np.percentile(boots, 2.5)), float(np.percentile(boots, 97.5))
    ci[T] = [lo, float(np.mean(d)), hi]

keep = any(ci[T][0] > 0 for T in (10, 25, 50, 100))
results["ci_diff"] = ci
results["chance"] = 1 / (N_CELLS - 2)
results["verdict"] = "KEEP_entanglement_matters" if keep else "KILL_estimator_correlation_complete_certified"

os.makedirs(os.path.dirname(OUT), exist_ok=True)
with open(OUT, "w") as f:
    json.dump(results, f, indent=2)
print(json.dumps({T: {"ent": results["acc_ent"][T], "cls": results["acc_cls"][T], "ci": ci[T]} for T in T_LIST}, indent=2))
print("mean corr e/c:", np.mean(results["mean_corr_e"]), np.mean(results["mean_corr_c"]))
print("verdict:", results["verdict"])
