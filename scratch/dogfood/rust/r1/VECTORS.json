[{"op":"add","args":[[1,2],[3,-1]],"expect":[4,1],"why":"componentwise addition"}, {"op":"add","args":[[0,0],[0,0]],"expect":[0,0],"why":"zero vector"}, {"op":"sub","args":[[5,3],[2,4]],"expect":[3,-1],"why":"componentwise subtraction"}, {"op":"sub","args":[[0,0],[1,1]],"expect":[-1,-1],"why":"subtract (1,1) from zero"}, {"op":"mul","args":[[1,0],[0,1]],"expect":[0,1],"why":"1 * ω = ω"}, {"op":"mul","args":[[1,1],[1,1]],"expect":[0,1],"why":"(1+ω)^2 = ω"}, {"op":"mul","args":[[2,1],[1,1]],"expect":[1,2],"why":"norm multiplicativity: norm(2,1)=3, norm(1,1)=1, norm(1,2)=3"}, {"op":"conj","args":[[3,4]],"expect":[-1,-4],"why":"conjugate of 3+4ω is -1-4ω"}, {"op":"conj","args":[[0,0]],"expect":[0,0],"why":"conjugate of zero is zero"}, {"op":"norm","args":[[2,3]],"expect":7,"why":"2² - 2·3 + 3² = 4-6+9=7"}, {"op":"norm","args":[[1,0]],"expect":1,"why":"norm of (1,0) is 1"}, {"op":"hexdist","args":[[0,0],[1,1]],"expect":1,"why":"da=-1, db=-1: same sign -> max(1,1)=1"}, {"op":"hexdist","args":[[0,0],[1,-1]],"expect":2,"why":"da=-1, db=1: different signs -> |da|+|db|=2"}, {"op":"div_rem","args":[[4,0],[2,0]],"expect":[[2,0],[0,0]],"why":"exact division: 4/2=2, remainder 0"}, {"op":"div_rem","args":[[1,0],[2,0]],"expect":[[1,0],[-1,0]],"why":"rounding: (1,0)/(2,0) -> q=(1,0) (0.5 rounds to 1), r=(-1,0)"}, {"op":"div_rem","args":[[-1,0],[2,0]],"expect":[[-1,0],[1,0]],"why":"rounding negative: (-1,0)/(2,0) -> q=(-1,0) (-0.5 rounds to -1), r=(1,0)"}, {"op":"rotate_60_omega","args":[[1,2]],"expect":[-2,-1],"why":"(1,2) * ω = -2 - ω"}, {"op":"rotate_60_omega","args":[[0,0]],"expect":[0,0],"why":"rotating zero vector"}]
