+const control_wr = +(cLeft / SEEDS.length).toFixed(4);
+console.log(`  control left win-rate ${(control_wr * 100).toFixed(1)}%`);
+
+console.log('M2 v3 advisory (attractor left, honest fallback) over 50 seeds…');
+const m2 = await M2(SEEDS);
