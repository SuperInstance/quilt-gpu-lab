+const m2 = await M2(SEEDS);
+console.log(`  advisory left win-rate ${(m2.advisory_wr * 100).toFixed(1)}%, advisory mode share ${(m2.advisory_share * 100).toFixed(1)}%`);
+
+const verdicts = {
