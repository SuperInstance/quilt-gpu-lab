+console.log('determinism pin: M1 seeds 1..3 twice…');
+const d1 = await M1([1, 2, 3]);
+const d2 = await M1([1, 2, 3]);
+const determinism = { pass: d1.head === d2.head && JSON.stringify(d1.h1) === JSON.stringify(d2.h1), head3: d1.head };
