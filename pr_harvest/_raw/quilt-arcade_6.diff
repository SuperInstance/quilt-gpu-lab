+});
+
+await H.check('v3 sense-local clock: tick.count reset across games does NOT explode A_eff (v2 defect class 2 closed)', async () => {
+  const e = bootSense();
+  await e.call('new_game', { seed: 4 });
+  await e.set('ball.x', 60); await e.set('ball.y', 20); await e.set('ball.vx', -0.9); await e.set('ball.vy', -0.2);
+  await e.call('sense.update', { kind: 'wall' }); // clock 1
+  // simulate new_game tick reset with persistent sense.* cells (the v2 explosion path)
+  await e.set('tick.count', 0);
+  await e.set('ball.x', 60); await e.set('ball.y', 30); await e.set('ball.vx', -0.9); await e.set('ball.vy', 0.1);
+  await e.call('sense.update', { kind: 'wall' }); // clock 2
+  const p = (await e.call('sense.predict')).data;
+  H.ok(Number.isFinite(p.A_eff) && p.A_eff >= 0 && p.A_eff <= 1, `A_eff bounded after tick reset, got ${p.A_eff}`);
